---
import { Meter } from "@/components/Meter";
import Base from "@/layouts/Base.astro";
import { metadataFor } from "@/lib/site-data";
import { NOT_FOUND_SOCIAL_IMAGE } from "@/lib/social";

// Next.js gave its default not-found page the root layout's head (the home
// metadata with the generated card) plus a noindex tag and its own title.
const home = metadataFor("/");
const head = {
  ...home,
  openGraph: { ...home.openGraph, images: [NOT_FOUND_SOCIAL_IMAGE] },
  noindex: true,
  statusTitle: "404: This page could not be found.",
};
---

<Base head={head} bodyClass="bg-page text-ink">
  <main class="container-wide flex min-h-screen flex-col justify-center py-16">
    <h1 class="font-readout text-title font-extrabold text-ink">404</h1>
    <Meter segments={16} lit={0} size="md" className="mt-6 max-w-md" />
    <h2 class="mt-6 text-lead font-normal text-ink-2">
      This page could not be found.
    </h2>
    <a href="/" class="btn btn-ghost mt-8 self-start">Home</a>
  </main>
</Base>
