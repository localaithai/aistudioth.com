---
import ModelsSection from "@/components/ModelsSection";
import Contact from "@/components/Contact.astro";
import Footer from "@/components/Footer.astro";
import Navbar from "@/components/Navbar";
import SitelinkTrail from "@/components/SitelinkTrail.astro";
import Base from "@/layouts/Base.astro";
import { metadataFor } from "@/lib/site-data";
---

<Base head={metadataFor("/models")}>
  <Navbar client:load pathname={Astro.url.pathname} />
  <main>
    <SitelinkTrail path="/models" />
    <ModelsSection client:load />
    <Contact />
  </main>
  <Footer />
</Base>
