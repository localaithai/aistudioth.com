---
import { assetUrl } from "@/lib/assets";

const partners = [
  { name: "Ingram Micro", logo: assetUrl("/partners/ingram-micro.svg") },
  { name: "TD SYNNEX", logo: assetUrl("/partners/td-synnex.svg") },
  { name: "SiS Distribution", logo: assetUrl("/partners/sis.png") },
  { name: "Ascenti", logo: assetUrl("/partners/ascenti-dark.png") },
  { name: "Eaton", logo: assetUrl("/partners/eaton.svg") },
  {
    name: "Schneider Electric",
    logo: assetUrl("/partners/schneider-electric.svg"),
  },
  { name: "VST ECS", logo: assetUrl("/partners/vst-ecs.png") },
] as const;
---

<section aria-labelledby="partners-heading" class="bg-page section-pad">
  <div class="container-wide">
    <div class="grid gap-6 md:grid-cols-12 md:items-end md:gap-12">
      <h2 id="partners-heading" class="text-h2 md:col-span-6">
        พาร์ทเนอร์ของ rig ทุกเครื่อง
      </h2>
      <p class="text-lead md:col-span-6">
        เราเชื่อมสเปกที่คุณเลือกกับเครือข่ายจัดหา ระบบไฟ และโครงสร้างพื้นฐาน
        เพื่อให้ build ที่ออกแบบไว้ส่งมอบและดูแลต่อได้จริง
      </p>
    </div>
    <ul
      class="mt-12 grid grid-cols-2 gap-px border-y border-ink bg-line sm:grid-cols-4 lg:grid-cols-7"
    >
      {
        partners.map((partner) => (
          <li class="flex min-h-24 items-center justify-center bg-page px-5 py-6 last:col-span-2 lg:last:col-span-1">
            <img
              src={partner.logo}
              alt={`${partner.name} logo`}
              width="160"
              height="64"
              loading="lazy"
              decoding="async"
              class="h-9 w-full object-contain text-transparent opacity-80 mix-blend-multiply contrast-125 grayscale"
            />
          </li>
        ))
      }
    </ul>
  </div>
</section>
