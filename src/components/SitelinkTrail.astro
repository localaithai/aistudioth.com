---
import { site } from "@/lib/site";
import { routes } from "@/lib/site-data";

type Props = { path: string };

const { path } = Astro.props;
const route = routes.find((candidate) => candidate.path === path);
const sitelinkName =
  route && "sitelinkName" in route ? route.sitelinkName : undefined;
if (!sitelinkName) throw new Error(`Missing sitelink name for ${path}`);

const breadcrumbs = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: site.url },
    { "@type": "ListItem", position: 2, name: sitelinkName },
  ],
}).replaceAll("<", "\\u003c");
---

<nav aria-label="Breadcrumb" class="container-wide pt-6 text-sm text-[#6e6e73]">
  <ol class="flex items-center gap-2">
    <li>
      <a href="/" class="hover:text-[#06c]">Home</a>
    </li>
    <li aria-hidden="true">/</li>
    <li aria-current="page" class="text-[#1d1d1f]">{sitelinkName}</li>
  </ol>
</nav>
<h1 class="sr-only">{sitelinkName}</h1>
<script type="application/ld+json" set:html={breadcrumbs} />
