---
import { site } from "@/lib/site";
import { routes } from "@/lib/site-data";

type Props = { path: string };

const { path } = Astro.props;
const route = routes.find((candidate) => candidate.path === path);
const sitelinkName =
  route && "sitelinkName" in route ? route.sitelinkName : undefined;
if (!sitelinkName) throw new Error(`Missing sitelink name for ${path}`);

const breadcrumbs = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: site.url },
    { "@type": "ListItem", position: 2, name: sitelinkName },
  ],
}).replaceAll("<", "\\u003c");
---

<div class="border-b border-ink bg-page">
  <div class="container-wide pt-3 pb-10 sm:pb-14">
    <nav aria-label="Breadcrumb" class="text-sm text-ink-2">
      <ol class="flex items-center gap-2">
        <li>
          <a href="/" class="inline-flex min-h-11 items-center hover:text-brand-deep">Home</a>
        </li>
        <li aria-hidden="true">/</li>
        <li aria-current="page" class="text-ink">{sitelinkName}</li>
      </ol>
    </nav>
    <h1 class="mt-6 font-readout text-title font-extrabold text-ink uppercase">{sitelinkName}</h1>
  </div>
</div>
<script type="application/ld+json" set:html={breadcrumbs} />
