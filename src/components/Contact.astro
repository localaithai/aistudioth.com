---
import { Mail, MessageCircle, Phone } from "@lucide/astro";

const channelClass =
  "flex items-center gap-3 rounded-2xl border border-black/[0.07] p-5 text-sm font-semibold text-[#1d1d1f] transition-[border-color,transform] duration-[350ms] ease-glide hover:-translate-y-0.5 hover:border-[#06c]/35 active:scale-[0.98]";
---

<section id="contact" class="section-white apple-section scroll-mt-16">
  <div class="container-wide">
    <div class="max-w-[44rem] mb-10">
      <p class="eyebrow mb-4">
        Configure your studio
      </p>
      <h2 class="text-h2 font-semibold mb-5">
        ส่ง workload ของคุณมา
      </h2>
      <p class="text-lead">
        บอก model, context และ stack ที่คุณจะใช้ เราจะเริ่มจาก memory budget
        ก่อนคุยเรื่อง build
      </p>
    </div>
    <div class="grid gap-8 lg:grid-cols-[1.4fr_0.6fr]">
      <div data-cta="form"></div>
      <aside class="space-y-4">
        <div class="rounded-3xl bg-[#1d1d1f] p-7 text-white">
          <h3 class="text-xl font-semibold text-white mb-3">อยากคุยโดยตรง?</h3>
          <p class="text-sm text-gray-300">
            ส่ง model list และ current stack มาก่อนได้
          </p>
        </div>
        <a data-cta="email" class={channelClass}>
          <Mail class="text-[#06c]" size={19} />
        </a>
        <a data-cta="tel" class={channelClass}>
          <Phone class="text-[#06c]" size={19} />
        </a>
        <a data-cta="line" class={channelClass}>
          <MessageCircle class="text-[#06c]" size={19} />LINE Official
        </a>
      </aside>
    </div>
  </div>
</section>
