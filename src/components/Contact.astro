---
import { Mail, MessageCircle, Phone } from "@lucide/astro";
import { assetUrl } from "@/lib/assets";

// cta.js injects the lead form, so its markup takes no classes: style it from the host.
const omniForm = [
  "[&_.omni-form]:grid [&_.omni-form]:gap-5 [&_.omni-form]:p-6 sm:[&_.omni-form]:grid-cols-2 sm:[&_.omni-form]:p-8",
  "[&_.omni-heading]:hidden",
  "[&_.omni-field]:block [&_.omni-field]:text-sm [&_.omni-field]:font-semibold [&_.omni-field]:text-ink",
  "sm:[&_.omni-field--textarea]:col-span-2",
  "[&_.omni-field.omni-field--checkbox]:flex [&_.omni-field--checkbox]:items-center [&_.omni-field--checkbox]:gap-2.5",
  "[&_.omni-input]:mt-2 [&_.omni-input]:w-full [&_.omni-input]:rounded-[4px] [&_.omni-input]:border [&_.omni-input]:border-edge [&_.omni-input]:bg-white [&_.omni-input]:px-4 [&_.omni-input]:py-3 [&_.omni-input]:text-base [&_.omni-input]:font-normal [&_.omni-input]:text-ink [&_.omni-input]:outline-none [&_.omni-input]:transition-[border-color,box-shadow] [&_.omni-input]:duration-200",
  "[&_.omni-input::placeholder]:text-ink-2",
  "[&_.omni-input:focus]:border-ink [&_.omni-input:focus]:shadow-[0_0_0_2px_var(--color-brand)]",
  "[&_textarea.omni-input]:min-h-32 [&_textarea.omni-input]:resize-y",
  "[&_.omni-field--checkbox_.omni-input]:mt-0 [&_.omni-field--checkbox_.omni-input]:w-auto [&_.omni-field--checkbox_.omni-input]:p-0",
  "[&_.omni-submit]:inline-flex [&_.omni-submit]:min-h-13 [&_.omni-submit]:w-full [&_.omni-submit]:cursor-pointer [&_.omni-submit]:items-center [&_.omni-submit]:justify-center [&_.omni-submit]:rounded-[4px] [&_.omni-submit]:bg-brand [&_.omni-submit]:px-6 [&_.omni-submit]:text-base [&_.omni-submit]:font-semibold [&_.omni-submit]:text-white [&_.omni-submit]:transition-[background-color,transform] [&_.omni-submit]:duration-200 sm:[&_.omni-submit]:col-span-2",
  "[&_.omni-submit:hover]:bg-brand-deep [&_.omni-submit:active]:translate-y-px [&_.omni-submit:disabled]:cursor-default [&_.omni-submit:disabled]:opacity-60",
  "[&_.omni-error]:text-sm [&_.omni-error]:font-medium [&_.omni-error]:text-brand-deep sm:[&_.omni-error]:col-span-2",
  "[&_.omni-success]:text-lg [&_.omni-success]:font-medium [&_.omni-success]:text-ink sm:[&_.omni-success]:col-span-2",
].join(" ");

const channelClass =
  "flex min-h-14 items-center gap-3 border-t border-ink text-base font-semibold text-ink transition-colors duration-200 hover:text-brand-deep";
---

<section id="contact" class="scroll-mt-16 bg-panel section-pad">
  <div class="container-wide grid gap-12 lg:grid-cols-12 lg:gap-14">
    <div class="lg:col-span-5">
      <h2 class="text-h2">ส่ง workload ของคุณมา</h2>
      <p class="mt-5 text-lead">
        บอก model, context และ stack ที่คุณจะใช้ เราจะเริ่มจาก memory budget
        ก่อนคุยเรื่อง build
      </p>
      <figure class="mt-10 max-sm:hidden">
        <div class="aspect-[3/2] overflow-hidden rounded-[6px] bg-panel">
          <img
            src={assetUrl("/photography/developer-desk.webp")}
            alt="developer นั่งทำงานที่โต๊ะ มี AI rig ขนาดเล็กวางข้างจอ"
            width="1536"
            height="1024"
            loading="lazy"
            decoding="async"
            class="block size-full object-cover text-transparent"
          />
        </div>
        <figcaption class="mt-3 text-sm text-ink-2">
          ภาพจำลอง · rig ข้างจอบนโต๊ะทำงาน
        </figcaption>
      </figure>
      <h3 class="mt-10 text-h3">อยากคุยโดยตรง?</h3>
      <p class="mt-2 text-base">ส่ง model list และ current stack มาก่อนได้</p>
      <div class="mt-5 border-b border-ink">
        <a data-cta="email" class={channelClass}>
          <Mail class="flex-none text-brand" size={18} />
        </a>
        <a data-cta="tel" class={channelClass}>
          <Phone class="flex-none text-brand" size={18} />
        </a>
        <a data-cta="line" class={channelClass}>
          <MessageCircle class="flex-none text-brand" size={18} />LINE Official
        </a>
      </div>
    </div>
    <div class="lg:col-span-7">
      <div class="plate overflow-hidden">
        <p class="legend border-b border-ink px-6 py-4 sm:px-8">
          Configure your studio
        </p>
        <div class={omniForm} data-cta="form"></div>
      </div>
    </div>
  </div>
</section>
