---
import { ArrowRight } from "@lucide/astro";
import { assetUrl } from "@/lib/assets";
import { site } from "@/lib/site";

const rigPrinciples = [
  "เลือกจาก model และ memory ที่ต้องใช้",
  "เลือก Mimir Suites Local หรือ bare hardware",
  "ควบคุม runtime และ stack ของคุณเอง",
];
---

<section class="bg-page">
  <div
    class="grid lg:h-[min(44rem,calc(100svh-9rem))] lg:min-h-[34rem] lg:grid-cols-2"
  >
    <div
      class="flex flex-col justify-center px-5 pt-10 pb-10 sm:px-8 lg:py-12 lg:pr-12 lg:pl-[max(2rem,calc((100vw-1240px)/2+2rem))]"
    >
      <p class="legend">AI rig บนโต๊ะ</p>
      <h1 class="mt-5 text-display font-extrabold tracking-[-0.02em] lg:text-[length:clamp(3rem,4vw_+_0.5rem,4rem)]">
        AI machine ของคุณ<br />อยู่บนโต๊ะคุณ
      </h1>
      <p class="mt-6 max-w-[34rem] text-lead">
        AI rig ที่คัดและปรับตาม model เพื่อรันในเครื่อง สำหรับ developer,
        researcher และทีมเทคนิคเล็กที่นั่งใช้มันทุกวัน.
      </p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a href={site.primaryCta.href} class="btn btn-primary">
          {site.primaryCta.label}
          <ArrowRight size={18} aria-hidden="true" />
        </a>
        <a href="/builds" class="btn btn-ghost">ดูสเปก build</a>
      </div>
    </div>

    <figure class="relative min-w-0 max-lg:aspect-[4/3] lg:h-full">
      <img
        src={assetUrl("/photography/hero-ai-rig.webp")}
        alt="AI rig บนโต๊ะทำงานสำหรับ developer"
        width="1536"
        height="1024"
        loading="eager"
        fetchpriority="high"
        decoding="async"
        class="absolute inset-0 size-full object-cover object-[38%_center] text-transparent"
      />
      <figcaption
        class="absolute bottom-3 left-3 rounded-[3px] bg-surface px-2.5 py-1 text-xs text-ink"
      >
        ภาพจำลองการใช้งาน · AI rig บนโต๊ะ developer
      </figcaption>
    </figure>
  </div>
  <div class="border-t border-ink">
    <ul
      class="container-wide grid max-sm:divide-y max-sm:divide-line sm:grid-cols-3 sm:divide-x sm:divide-line"
    >
      {
        rigPrinciples.map((item) => (
          <li class="flex min-h-14 items-center gap-3 py-4 text-base font-medium text-ink sm:px-6 sm:first:pl-0">
            <span aria-hidden="true" class="size-2 flex-none bg-brand" />
            {item}
          </li>
        ))
      }
    </ul>
  </div>
</section>
